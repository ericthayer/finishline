{
  "name": "finishline",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Personal command center for projects born from agentic development.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "tokens": "node design/build-tokens.mjs src/ui/tokens/tokens.css",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
